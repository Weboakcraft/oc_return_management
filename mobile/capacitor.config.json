{
  "appId": "com.returndesk.app",
  "appName": "Return Desk",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0e3b3c"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
